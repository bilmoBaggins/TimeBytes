{
  "expo": {
    "name": "TimeBytes",
    "slug": "BBytes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/timebytes-app-icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBF3EC",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "icon": "./assets/timebytes-app-icon.png",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.bilalm9steam.TimeBytes"
    },
    "web": {
      "favicon": "./assets/timebytes-app-icon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f912ab9f-667e-4640-a7c0-df1921b1856b",
      "fallbackToCacheTimeout": 3000
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TimeBytes to use the camera for employee recognition",
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing",
      "expo-sqlite",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "f912ab9f-667e-4640-a7c0-df1921b1856b"
      }
    }
  }
}
